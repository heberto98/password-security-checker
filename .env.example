# Referencia: la aplicación NO carga este archivo automáticamente.
# Define estas variables en la terminal o en el futuro proveedor.
APP_ENV=development
DEPLOYMENT_TARGET=generic
BIND_HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_ORIGIN=
TRUSTED_PROXY_IPS=
MAX_CONCURRENCY=64
BODY_TIMEOUT_SECONDS=5

# Producción requiere APP_ENV=production y BIND_HOST acorde a la red privada.
# ALLOWED_HOSTS: dominio real, sin esquema, puerto ni comodín.
# PUBLIC_ORIGIN: https://dominio-real (sin ruta).
# TRUSTED_PROXY_IPS: IP/CIDR reales del proxy; nunca * ni 0.0.0.0/0 ni ::/0.
# No hay secretos que configurar. No guardes contraseñas aquí.

# Render Free: crea SOLO APP_ENV=production y DEPLOYMENT_TARGET=render-free.
# No copies los valores locales de este archivo al panel de Render.
# Render proporciona RENDER, RENDER_SERVICE_TYPE, RENDER_EXTERNAL_HOSTNAME,
# RENDER_EXTERNAL_URL y PORT. Host y origen se derivan de esas variables.
# No configures TRUSTED_PROXY_IPS ni FORWARDED_ALLOW_IPS.
# Este modo no verifica el plan: antes de cambiar a pago, revisar frontera de red.
